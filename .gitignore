# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local runtime state
.picone/
*.log

# Workspace files generated inside this repo by the picker
/*.workspace.json

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Environment
.env
